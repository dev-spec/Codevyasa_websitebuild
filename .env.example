# ============================================================================
# CodeVyasa.com — environment variables
# Copy to `.env.local` for local dev. NEVER commit real keys.
# For the STATIC EXPORT build, only the NEXT_PUBLIC_* values below are used
# (they are inlined at build time). The server keys are for the OPTIONAL
# Node backend in /server-optional.
# ============================================================================

# --- Static build (client-side) --------------------------------------------

# Public site URL — used for canonical tags, sitemap, JSON-LD, OG image URLs.
NEXT_PUBLIC_SITE_URL=https://www.codevyasa.com

# Where the contact form POSTs. Any endpoint that accepts JSON works:
#  - a serverless function (see /server-optional),
#  - a form backend (Formspree/Basin/Getform),
#  - your CRM webhook.
# Leave blank to run the form in "demo mode" (validates + shows success UI,
# logs payload to console, does not transmit).
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional: a real booking link for the "BOOK A MEETING" CTA (Calendly/cal.com).
# Falls back to scrolling to the contact form when empty.
NEXT_PUBLIC_BOOKING_URL=

# Optional: Google Analytics 4 measurement ID. Analytics only loads when set.
NEXT_PUBLIC_GA4_ID=

# Optional: Cloudflare Turnstile site key (spam protection, client widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Optional Node backend (/server-optional) ------------------------------
# These are NOT used by the static build. See /server-optional/README.md.

# Resend API key for transactional email to sales@codevyasa.com
RESEND_API_KEY=

# Fallback SMTP (used if RESEND_API_KEY is absent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Destination + reply address for contact submissions
CONTACT_TO_EMAIL=sales@codevyasa.com
CONTACT_FROM_EMAIL=website@codevyasa.com

# Postgres (Neon/Supabase) for persisting submissions
DATABASE_URL=

# Cloudflare Turnstile secret (server-side verification)
TURNSTILE_SECRET_KEY=
